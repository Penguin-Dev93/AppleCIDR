<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="AppBackgroundColor">#EEF0FF</Color>
  <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
  <Color x:Key="SurfaceBackgroundColor">#F5F6FF</Color>
  <Color x:Key="AccentPrimaryColor">#6C63FF</Color>
  <Color x:Key="AccentSecondaryColor">#7C74FF</Color>
  <Color x:Key="TextPrimaryColor">#1A1B2E</Color>
  <Color x:Key="TextSecondaryColor">#6B6B8D</Color>
  <Color x:Key="BorderBrushColor">#D8D8F0</Color>
  <Color x:Key="SuccessColorValue">#16A34A</Color>
  <Color x:Key="ErrorColorValue">#DC2626</Color>
  <Color x:Key="InputBackgroundColor">#FFFFFF</Color>
  <Color x:Key="ToggleTrackColor">#D8D8F0</Color>

  <SolidColorBrush x:Key="AppBackground" Color="{DynamicResource AppBackgroundColor}" />
  <SolidColorBrush x:Key="CardBackground" Color="{DynamicResource CardBackgroundColor}" />
  <SolidColorBrush x:Key="SurfaceBackground" Color="{DynamicResource SurfaceBackgroundColor}" />
  <SolidColorBrush x:Key="AccentPrimary" Color="{DynamicResource AccentPrimaryColor}" />
  <SolidColorBrush x:Key="AccentSecondary" Color="{DynamicResource AccentSecondaryColor}" />
  <SolidColorBrush x:Key="TextPrimary" Color="{DynamicResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondary" Color="{DynamicResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderBrushColor}" />
  <SolidColorBrush x:Key="SuccessColor" Color="{DynamicResource SuccessColorValue}" />
  <SolidColorBrush x:Key="ErrorColor" Color="{DynamicResource ErrorColorValue}" />
  <SolidColorBrush x:Key="InputBackground" Color="{DynamicResource InputBackgroundColor}" />
  <SolidColorBrush x:Key="ToggleTrack" Color="{DynamicResource ToggleTrackColor}" />
  <SolidColorBrush x:Key="PrimaryButtonText" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ShadowBrush" Color="#000000" Opacity="0.12" />
</ResourceDictionary>
