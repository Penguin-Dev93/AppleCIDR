<Window x:Class="AppleCIDR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AppleCIDR"
        Width="760"
        Height="680"
        MinWidth="680"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        Icon="Resources/icon.ico"
        Background="{DynamicResource AppBackground}">
  <Grid Background="{DynamicResource AppBackground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="44" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{DynamicResource AppBackground}"
            Padding="18,8"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="AppleCIDR"
                     Foreground="{DynamicResource AccentPrimary}"
                     FontWeight="Bold"
                     FontSize="16" />
          <TextBlock Text="{Binding AppVersion}"
                     Style="{StaticResource SecondaryTextStyle}"
                     Margin="8,2,0,0" />
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
          <TextBlock x:Name="ThemeLabel"
                     Text="Dark"
                     Style="{StaticResource SecondaryTextStyle}"
                     VerticalAlignment="Center"
                     Margin="0,0,8,0" />
          <CheckBox x:Name="ThemeToggle"
                    Style="{StaticResource ToggleSwitchStyle}"
                    IsChecked="False"
                    Checked="ThemeToggle_Changed"
                    Unchecked="ThemeToggle_Changed"
                    VerticalAlignment="Center"
                    ToolTip="Switch theme" />
          <Button Content="_"
                  Style="{StaticResource ChromeButtonStyle}"
                  Margin="14,0,4,0"
                  Click="Minimize_Click"
                  ToolTip="Minimize" />
          <Button Content="X"
                  Style="{StaticResource ChromeButtonStyle}"
                  Click="Close_Click"
                  ToolTip="Close" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <Grid Margin="24">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="320" />
          <ColumnDefinition Width="20" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock Text="Subnet Calculator"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,4" />
            <TextBlock Text="Calculate IPv4 subnet details from an address and CIDR prefix."
                       Style="{StaticResource SecondaryTextStyle}"
                       Margin="0,0,0,20" />

            <TextBlock Text="IPV4 ADDRESS" Style="{StaticResource SectionLabelStyle}" />
            <TextBox Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,8,0,0"
                     ToolTip="Enter an IPv4 address" />
            <TextBlock Text="{Binding ValidationMessage}"
                       Foreground="{DynamicResource ErrorColor}"
                       FontSize="11"
                       Margin="0,6,0,0"
                       Visibility="{Binding ValidationVisibility}" />

            <TextBlock Text="CIDR PREFIX"
                       Style="{StaticResource SectionLabelStyle}"
                       Margin="0,20,0,0" />
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="58" />
              </Grid.ColumnDefinitions>
              <Slider Minimum="0"
                      Maximum="32"
                      TickFrequency="1"
                      IsSnapToTickEnabled="True"
                      Value="{Binding CidrPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              <Border Grid.Column="1"
                      Background="{DynamicResource SurfaceBackground}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="10"
                      Padding="10,7"
                      Margin="12,0,0,0">
                <TextBlock Text="{Binding CidrLabel}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
              </Border>
            </Grid>
            <Grid Margin="0,2,70,0">
              <TextBlock Text="/0" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Left" />
              <TextBlock Text="/32" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Right" />
            </Grid>

            <Button Content="Copy Summary"
                    Command="{Binding CopySummaryCommand}"
                    IsEnabled="{Binding IsValid}"
                    Margin="0,24,0,0" />

            <Border BorderBrush="{DynamicResource SuccessColor}"
                    BorderThickness="1"
                    Background="{DynamicResource SurfaceBackground}"
                    CornerRadius="10"
                    Padding="14,10"
                    Margin="0,12,0,0"
                    Visibility="{Binding CopyStatusVisibility}">
              <TextBlock Text="{Binding CopyStatusMessage}"
                         Foreground="{DynamicResource SuccessColor}"
                         FontSize="12" />
            </Border>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock Text="Calculated Results"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,4" />
            <TextBlock Text="Results update as the address or prefix changes."
                       Style="{StaticResource SecondaryTextStyle}"
                       Margin="0,0,0,18" />

            <Border Style="{StaticResource ResultRowStyle}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Subnet Mask" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock Grid.Column="1" Text="{Binding SubnetMask}" HorizontalAlignment="Right" FontWeight="SemiBold" />
              </Grid>
            </Border>
            <Border Style="{StaticResource ResultRowStyle}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Wildcard Mask" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock Grid.Column="1" Text="{Binding WildcardMask}" HorizontalAlignment="Right" FontWeight="SemiBold" />
              </Grid>
            </Border>
            <Border Style="{StaticResource ResultRowStyle}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Usable Hosts" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock Grid.Column="1" Text="{Binding UsableHosts}" HorizontalAlignment="Right" FontWeight="SemiBold" />
              </Grid>
            </Border>
            <Border Style="{StaticResource ResultRowStyle}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Network Address" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock Grid.Column="1" Text="{Binding NetworkAddress}" HorizontalAlignment="Right" FontWeight="SemiBold" />
              </Grid>
            </Border>
            <Border Style="{StaticResource ResultRowStyle}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="First Host" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock Grid.Column="1" Text="{Binding FirstHost}" HorizontalAlignment="Right" FontWeight="SemiBold" />
              </Grid>
            </Border>
            <Border Style="{StaticResource ResultRowStyle}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Last Host" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock Grid.Column="1" Text="{Binding LastHost}" HorizontalAlignment="Right" FontWeight="SemiBold" />
              </Grid>
            </Border>
            <Border Style="{StaticResource ResultRowStyle}" Margin="0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Broadcast Address" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock Grid.Column="1" Text="{Binding BroadcastAddress}" HorizontalAlignment="Right" FontWeight="SemiBold" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>
